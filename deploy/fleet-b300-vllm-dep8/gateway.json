{
  "listen": "0.0.0.0:8080",
  "max_active": 512,
  "max_pending": 128,
  "standard_max_output_tokens": 8192,
  "tenants": [
    {
      "id": "coding",
      "token_env": "DSUF_CODING_TOKEN",
      "max_active": 512,
      "max_pending": 128,
      "max_buffered_bytes": 536870912,
      "max_reserved_output_tokens": 4194304
    }
  ],
  "backends": [
    {
      "id": "standard-0",
      "url": "http://dsuf-standard-0.dsuf-standard:8000",
      "pool": "standard",
      "cohort": "vllm-dep8-b300-128k",
      "max_inflight": 256,
      "readiness_path": "/health",
      "probe_capacity": false,
      "vllm_cache_salt": true
    },
    {
      "id": "standard-1",
      "url": "http://dsuf-standard-1.dsuf-standard:8000",
      "pool": "standard",
      "cohort": "vllm-dep8-b300-128k",
      "max_inflight": 256,
      "readiness_path": "/health",
      "probe_capacity": false,
      "vllm_cache_salt": true
    }
  ],
  "standard_accepts_images": false
}
